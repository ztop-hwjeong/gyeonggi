{
  "name": "gyeonggi-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "check": "tsc --noEmit && biome check .",
    "format": "biome check --write .",
    "api:generate": "openapi-typescript http://localhost:8080/api/openapi.json -o src/shared/api/schema.d.ts",
    "test:e2e": "playwright test",
    "pretest:e2e": "npm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.104.5",
    "next": "16.4.2",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
